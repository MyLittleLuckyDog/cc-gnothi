.DS_Store
.claude/settings.local.json
src/target/
.env.local

# Per-version raw prompt body dumps from extract-ast.js --dump-prompts.
# Local-only artifacts; the analyzed .md specs in versions/v*/ are the
# tracked product, raw bodies are inputs we pull from the bundle and
# inject into the analyze prompt — no need to track them in git.
versions/*/_raw/

# Node.js dependencies
node_modules/

# Arbor symbol-graph snapshot — produced by `arbor index --save` from
# analyze-new-version.js (G3-B integration). Repo-local cache; the
# tracked product is versions/v*/_handlers.json.
.arbor/
